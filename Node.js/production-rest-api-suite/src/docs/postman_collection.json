{
  "info": {
    "name": "Production REST API Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "itemId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"Password123\"\n}" }
      }
    },
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"Password123\"\n}" }
      }
    },
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/profile"
      }
    },
    {
      "name": "List Items",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items?page=1&limit=10&sortBy=createdAt&sortOrder=desc"
      }
    },
    {
      "name": "Create Item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/items",
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Premium Keyboard\",\n  \"description\": \"A premium mechanical keyboard for developers.\",\n  \"price\": 149.99,\n  \"category\": \"electronics\",\n  \"image\": \"https://example.com/image.jpg\",\n  \"status\": \"published\"\n}" }
      }
    }
  ]
}
