{
  "name": "production-rest-api-suite",
  "version": "1.0.0",
  "description": "Production-grade full-stack REST API with JWT auth, third-party API integration, CRUD, filtering, pagination, and premium React frontend.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server.js",
    "seed": "node src/scripts/syncExternalItems.js",
    "lint": "eslint .",
    "test": "node --test",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9"
  }
}
