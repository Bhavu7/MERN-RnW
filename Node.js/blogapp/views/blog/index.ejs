<!-- views/blog/index.ejs : list of all posts -->
<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold mb-8">Latest Posts</h1>

  <% if (posts.length === 0) { %>
    <p class="text-gray-500">No posts yet. Be the first to write one!</p>
  <% } %>

  <div class="grid sm:grid-cols-2 gap-6">
    <% posts.forEach((post, i) => { %>
      <a href="/blog/<%= post._id %>"
        class="bg-white rounded-2xl shadow hover:shadow-xl overflow-hidden transition-all duration-300 hover:-translate-y-1 fade-in"
        style="animation-delay: <%= i * 60 %>ms">
        <img src="<%= post.image %>" alt="<%= post.title %>" class="w-full h-44 object-cover" />
        <div class="p-5">
          <h2 class="text-lg font-semibold mb-1 line-clamp-1"><%= post.title %></h2>
          <p class="text-gray-500 text-sm line-clamp-2"><%= post.content %></p>
          <div class="flex items-center gap-2 mt-4">
            <img src="<%= post.author.avatar %>" class="w-6 h-6 rounded-full" />
            <span class="text-xs text-gray-400"><%= post.author.name %> · <%= post.createdAt.toDateString() %></span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
</div>
