<%- include("partials/header") %>

<div class="detail">
  <div class="detail-poster">
    <% if (movie.poster) { %>
      <img src="/uploads/<%= movie.poster %>" alt="<%= movie.title %>" />
    <% } else { %>
      <div class="no-poster big">No Poster</div>
    <% } %>
  </div>

  <div class="detail-info">
    <h1><%= movie.title %></h1>

    <div class="info-row"><span class="label">Director</span><span class="value"><%= movie.director || "—" %></span></div>
    <div class="info-row"><span class="label">Genre</span><span class="value"><%= movie.genre || "—" %></span></div>
    <div class="info-row"><span class="label">Year</span><span class="value"><%= movie.year || "—" %></span></div>
    <div class="info-row"><span class="label">Rating</span><span class="value"><span class="star">⭐</span> <%= movie.rating != null ? movie.rating : "—" %></span></div>

    <p class="desc"><%= movie.description || "No description." %></p>

    <div class="actions">
      <a href="/movies/<%= movie._id %>/edit" class="btn">Edit</a>
      <!-- DELETE via method-override -->
      <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this movie?')">
        <button type="submit" class="btn danger">Delete</button>
      </form>
      <a href="/" class="btn ghost">Back</a>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
