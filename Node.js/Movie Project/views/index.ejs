<%- include("partials/header") %>

<div class="page-head">
  <h1>All Movies</h1>
  <span class="count"><%= movies.length %> title<%= movies.length === 1 ? "" : "s" %></span>
</div>

<!-- show message when there are no movies yet -->
<% if (movies.length === 0) { %>
  <p class="empty">No movies yet. Click "Add Movie" to create one.</p>
<% } else { %>
  <div class="grid">
    <!-- loop over every movie and show a card -->
    <% movies.forEach(movie => { %>
      <div class="card">
        <a href="/movies/<%= movie._id %>">
          <div class="poster-wrap">
            <% if (movie.poster) { %>
              <img src="/uploads/<%= movie.poster %>" alt="<%= movie.title %>" />
            <% } else { %>
              <div class="no-poster">No Poster</div>
            <% } %>
            <% if (movie.rating != null) { %>
              <span class="rating-badge">⭐ <%= movie.rating %></span>
            <% } %>
          </div>
          <div class="card-body">
            <h3><%= movie.title %></h3>
            <p class="meta"><%= movie.genre || "—" %> · <%= movie.year || "—" %></p>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include("partials/footer") %>
